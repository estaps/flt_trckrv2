# Postgres. Tables go into the schema named here, so an existing server can be shared.
DATABASE_URL=postgresql://flighttracker:changeme@postgres:5432/flighttracker?schema=flighttracker

# Expense totals are converted to this currency.
HOME_CURRENCY=USD

# Optional bearer token for the REST API. Leave empty to disable API auth (LAN only).
API_TOKEN=

# Where uploaded files and email bodies are stored inside the container.
FILES_DIR=/data/files

# Take a pg_dump into BACKUP_DIR before running migrations on startup.
BACKUP_BEFORE_MIGRATE=true
BACKUP_DIR=/data/backups

# LLM used for extraction. Swap endpoints and models here without code changes.
# LLM_PROVIDER: "openai" (any OpenAI-compatible server: Ollama, vLLM, llama.cpp,
# LM Studio, OpenRouter, OpenAI) or "anthropic".
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1
# Model used for images (boarding passes, receipts). Defaults to LLM_MODEL.
LLM_VISION_MODEL=

# Email import. The worker watches this mailbox and imports every new message.
# For Proton, use docker-compose.proton.yml, which sets the host, port and TLS options for Bridge;
# put the username and password that Bridge's `info` command shows here.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_TLS_INSECURE=false
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=300
