# Postgres. Tables go into the schema named here, so an existing server can be shared.
DATABASE_URL=postgresql://flighttracker:changeme@postgres:5432/flighttracker?schema=flighttracker

# Expense totals are converted to this currency.
HOME_CURRENCY=USD

# Optional bearer token for the REST API. Leave empty to disable API auth (LAN only).
API_TOKEN=

# Where uploaded files and email bodies are stored inside the container.
FILES_DIR=/data/files

# Take a pg_dump into BACKUP_DIR before running migrations on startup.
BACKUP_BEFORE_MIGRATE=true
BACKUP_DIR=/data/backups

# LLM used for extraction. Swap endpoints and models here without code changes.
# LLM_PROVIDER: "openai" (any OpenAI-compatible server: Ollama, vLLM, llama.cpp,
# LM Studio, OpenRouter, OpenAI) or "anthropic".
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1
# Model used for images (boarding passes, receipts). Defaults to LLM_MODEL.
LLM_VISION_MODEL=

# Price tracking through the flight-finder sidecar (see docker-compose.yml).
# Leave FLIGHT_FINDER_URL empty to turn price checks off.
FLIGHT_FINDER_URL=http://flight-finder:3003
# API token the app sends to the sidecar. The sidecar registers it on its first
# start. Make one with: echo ff_$(openssl rand -hex 32)
FLIGHT_FINDER_TOKEN=
# How often the app reads new fares from the sidecar, in minutes (0 = off).
PRICE_SYNC_MINUTES=60
# Where alerts are sent: an ntfy topic URL such as https://ntfy.sh/my-flights,
# or any URL that accepts a POST. Empty keeps alerts in the app only.
ALERT_WEBHOOK_URL=
# "ntfy" sends the message as text with a Title header; "json" posts the alert as JSON.
ALERT_WEBHOOK_FORMAT=ntfy

# Sidecar settings, read by docker compose.
# A separate database for flight-finder on the same Postgres server, e.g.
# postgresql://flightfinder:changeme@postgres:5432/flight_finder
FLIGHT_FINDER_DATABASE_URL=
# Admin and sign-in passwords for the sidecar's own web UI (http://host:3003),
# where its LLM provider is set. Read on its first start only.
FLIGHT_FINDER_ADMIN_PASSWORD=
FLIGHT_FINDER_PASSWORD=
# How often the sidecar scrapes each tracked route, in hours.
FLIGHT_FINDER_CHECK_HOURS=3
# Keep sidecar sessions across restarts; generate with: openssl rand -hex 32
FLIGHT_FINDER_SESSION_SECRET=
FLIGHT_FINDER_CRON_SECRET=
# Host port for the sidecar's web UI.
FLIGHT_FINDER_PORT=3003
# Pin a release here once it works, e.g. ghcr.io/affromero/flight-finder:<tag>
FLIGHT_FINDER_IMAGE=ghcr.io/affromero/flight-finder:latest
