{
  "name": "flight-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run build:worker",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node22 --outfile=dist/worker.js --external:@prisma/client --external:.prisma --log-level=warning",
    "worker": "npm run build:worker && node --env-file=.env dist/worker.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "prisma": "6.19.3",
    "typescript": "^5.6.0",
    "vitest": "3.2.7"
  }
}
