// Tables live in the Postgres schema named in DATABASE_URL (?schema=flighttracker),
// so the app can share an existing Postgres server without touching other data.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentSource {
  imap
  upload
  api
}

enum DocumentStatus {
  new
  parsed
  needs_review
  confirmed
  ignored
  failed
}

enum ExtractionMethod {
  template
  barcode
  schema_org
  llm
  ocr
  manual
}

enum FlightStatus {
  scheduled
  changed
  cancelled
  flown
}

enum BookingStatus {
  held
  ticketed
  cancelled
}

enum ECreditStatus {
  active
  used
}

enum AttachmentKind {
  ticket
  receipt
  boarding_pass
  other
}

// A raw email or uploaded file. Everything else traces back to one of these.
model Document {
  id          String         @id @default(uuid()) @db.Uuid
  source      DocumentSource
  messageId   String?        @unique @map("message_id")
  sha256      String         @unique
  mimeType    String         @map("mime_type")
  subject     String?
  sender      String?
  storagePath String         @map("storage_path")
  status      DocumentStatus @default(new)
  receivedAt  DateTime       @default(now()) @map("received_at")

  extractions Extraction[]
  attachments Attachment[]
  bookings    Booking[]
  expenses    Expense[]
  changes     FlightChange[]
  ecredits    ECredit[]

  @@map("documents")
}

// One parse attempt. Kept so parsers and models can be re-run and compared.
model Extraction {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  method     ExtractionMethod
  model      String?
  rawJson    Json             @map("raw_json")
  confidence Float?
  createdAt  DateTime         @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("extractions")
}

model Trip {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  bookings Booking[]
  flights  Flight[]
  expenses Expense[]

  @@map("trips")
}

// One reservation, identified by its confirmation code (PNR).
model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  tripId           String?       @map("trip_id") @db.Uuid
  confirmationCode String        @unique @map("confirmation_code")
  ticketNumber     String?       @unique @map("ticket_number")
  status           BookingStatus @default(ticketed)
  airlineOrAgency  String?       @map("airline_or_agency")
  passengerName    String?       @map("passenger_name")
  bookedAt         DateTime?     @map("booked_at")
  totalAmount      Decimal?      @map("total_amount") @db.Decimal(12, 2)
  currency         String?       @db.Char(3)
  documentId       String?       @map("document_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  trip     Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  flights  Flight[]
  expenses Expense[]

  @@map("bookings")
}

// Airline travel credit, e.g. a Delta eCredit left over from a cancelled or changed ticket.
model ECredit {
  id                 String        @id @default(uuid()) @db.Uuid
  number             String        @unique
  airline            String?
  // Unknown until a receipt shows it; a cancellation email only gives the number.
  amount             Decimal?      @db.Decimal(12, 2)
  currency           String?       @db.Char(3)
  expiresOn          DateTime?     @map("expires_on") @db.Date
  status             ECreditStatus @default(active)
  sourceTicketNumber String?       @map("source_ticket_number")
  documentId         String?       @map("document_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("ecredits")
}

// One flight segment. Local date and times are what the airline prints;
// UTC times are filled in when the airport time zones are known.
model Flight {
  id           String       @id @default(uuid()) @db.Uuid
  bookingId    String?      @map("booking_id") @db.Uuid
  tripId       String?      @map("trip_id") @db.Uuid
  carrier      String       @db.VarChar(3)
  flightNumber String       @map("flight_number") @db.VarChar(8)
  depAirport   String       @map("dep_airport") @db.Char(3)
  arrAirport   String       @map("arr_airport") @db.Char(3)
  depDate      DateTime     @map("dep_date") @db.Date
  depTimeLocal String?      @map("dep_time_local") @db.VarChar(5)
  arrTimeLocal String?      @map("arr_time_local") @db.VarChar(5)
  depTimeUtc   DateTime?    @map("dep_time_utc")
  arrTimeUtc   DateTime?    @map("arr_time_utc")
  seat         String?
  cabin        String?
  fareClass    String?      @map("fare_class") @db.VarChar(2)
  status       FlightStatus @default(scheduled)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  booking Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  trip    Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  changes FlightChange[]
  watches PriceWatch[]

  @@unique([carrier, flightNumber, depDate])
  @@index([tripId])
  @@map("flights")
}

// History of a flight's fields, written when a schedule-change email updates it.
model FlightChange {
  id         String   @id @default(uuid()) @db.Uuid
  flightId   String   @map("flight_id") @db.Uuid
  documentId String?  @map("document_id") @db.Uuid
  field      String
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  flight   Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([flightId])
  @@map("flight_changes")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String?  @map("trip_id") @db.Uuid
  bookingId  String?  @map("booking_id") @db.Uuid
  category   String
  merchant   String?
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @db.Char(3)
  amountHome Decimal? @map("amount_home") @db.Decimal(12, 2)
  spentOn    DateTime @map("spent_on") @db.Date
  documentId String?  @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  trip     Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([bookingId, category])
  @@index([tripId])
  @@map("expenses")
}

model Attachment {
  id            String         @id @default(uuid()) @db.Uuid
  documentId    String         @map("document_id") @db.Uuid
  kind          AttachmentKind @default(other)
  storagePath   String         @map("storage_path")
  thumbnailPath String?        @map("thumbnail_path")
  createdAt     DateTime       @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Airport {
  iata    String  @id @db.Char(3)
  name    String
  city    String?
  state   String?
  country String? @db.Char(2)
  tz      String?

  @@map("airports")
}

enum PriceWatchStatus {
  active
  paused
  expired
  error
}

enum PriceAlertKind {
  drop
  target
  below_paid
}

// A route and date (or a booked flight) whose fares are checked through the
// flight-finder sidecar. Each check that returns fares adds one PricePoint.
model PriceWatch {
  id            String           @id @default(uuid()) @db.Uuid
  label         String?
  origin        String           @db.Char(3)
  destination   String           @db.Char(3)
  departDate    DateTime         @map("depart_date") @db.Date
  // Set for round trips; fares are then the round-trip total.
  returnDate    DateTime?        @map("return_date") @db.Date
  cabin         String           @default("economy")
  // Airline name as fare sites print it, e.g. "Delta". Empty means any airline.
  airline       String?
  // e.g. "DL1234". When set, only that flight's fare counts.
  flightNumber  String?          @map("flight_number")
  // Local departure time "HH:MM", used to find the flight when fares lack a flight number.
  departTime    String?          @map("depart_time") @db.VarChar(5)
  maxStops      Int?             @map("max_stops")
  flightId      String?          @map("flight_id") @db.Uuid
  paidPrice     Decimal?         @map("paid_price") @db.Decimal(12, 2)
  currency      String           @default("USD") @db.Char(3)
  targetPrice   Decimal?         @map("target_price") @db.Decimal(12, 2)
  dropAmount    Decimal?         @map("drop_amount") @db.Decimal(12, 2)
  // Fraction, 0.1 means 10%.
  dropPercent   Float?           @map("drop_percent")
  // Price that drops are measured from: the high since the last drop alert.
  dropBaseline  Decimal?         @map("drop_baseline") @db.Decimal(12, 2)
  status        PriceWatchStatus @default(active)
  remoteQueryId String?          @unique @map("remote_query_id")
  remoteToken   String?          @map("remote_token")
  // Newest fare timestamp already read from the sidecar.
  syncedThrough DateTime?        @map("synced_through")
  lastCheckedAt DateTime?        @map("last_checked_at")
  lastError     String?          @map("last_error")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  flight Flight?      @relation(fields: [flightId], references: [id], onDelete: SetNull)
  points PricePoint[]
  alerts PriceAlert[]

  @@index([status])
  @@map("price_watches")
}

// The cheapest matching fare from one sidecar check.
model PricePoint {
  id           String   @id @default(uuid()) @db.Uuid
  watchId      String   @map("watch_id") @db.Uuid
  observedAt   DateTime @map("observed_at")
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @db.Char(3)
  airline      String?
  flightNumber String?  @map("flight_number")
  departTime   String?  @map("depart_time")
  stops        Int?
  bookingUrl   String?  @map("booking_url")
  // "flight" when the watched flight itself was found, "airline" when only the
  // airline's cheapest fare was available, "route" for any airline.
  matchedBy    String   @map("matched_by")
  fareCount    Int      @map("fare_count")

  watch PriceWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, observedAt])
  @@map("price_points")
}

model PriceAlert {
  id            String         @id @default(uuid()) @db.Uuid
  watchId       String         @map("watch_id") @db.Uuid
  kind          PriceAlertKind
  price         Decimal        @db.Decimal(12, 2)
  previousPrice Decimal?       @map("previous_price") @db.Decimal(12, 2)
  currency      String         @db.Char(3)
  message       String
  notifiedAt    DateTime?      @map("notified_at")
  readAt        DateTime?      @map("read_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  watch PriceWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId])
  @@map("price_alerts")
}
