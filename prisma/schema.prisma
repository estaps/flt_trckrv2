// Tables live in the Postgres schema named in DATABASE_URL (?schema=flighttracker),
// so the app can share an existing Postgres server without touching other data.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentSource {
  imap
  upload
  api
}

enum DocumentStatus {
  new
  parsed
  needs_review
  confirmed
  ignored
  failed
}

enum ExtractionMethod {
  template
  barcode
  schema_org
  llm
  ocr
  manual
}

enum FlightStatus {
  scheduled
  changed
  cancelled
  flown
}

enum BookingStatus {
  held
  ticketed
  cancelled
}

enum ECreditStatus {
  active
  used
}

enum AttachmentKind {
  ticket
  receipt
  boarding_pass
  other
}

// A raw email or uploaded file. Everything else traces back to one of these.
model Document {
  id          String         @id @default(uuid()) @db.Uuid
  source      DocumentSource
  messageId   String?        @unique @map("message_id")
  sha256      String         @unique
  mimeType    String         @map("mime_type")
  subject     String?
  sender      String?
  storagePath String         @map("storage_path")
  status      DocumentStatus @default(new)
  receivedAt  DateTime       @default(now()) @map("received_at")

  extractions Extraction[]
  attachments Attachment[]
  bookings    Booking[]
  expenses    Expense[]
  changes     FlightChange[]
  ecredits    ECredit[]

  @@map("documents")
}

// One parse attempt. Kept so parsers and models can be re-run and compared.
model Extraction {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  method     ExtractionMethod
  model      String?
  rawJson    Json             @map("raw_json")
  confidence Float?
  createdAt  DateTime         @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("extractions")
}

model Trip {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  bookings Booking[]
  flights  Flight[]
  expenses Expense[]

  @@map("trips")
}

// One reservation, identified by its confirmation code (PNR).
model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  tripId           String?       @map("trip_id") @db.Uuid
  confirmationCode String        @unique @map("confirmation_code")
  ticketNumber     String?       @unique @map("ticket_number")
  status           BookingStatus @default(ticketed)
  airlineOrAgency  String?       @map("airline_or_agency")
  passengerName    String?       @map("passenger_name")
  bookedAt         DateTime?     @map("booked_at")
  totalAmount      Decimal?      @map("total_amount") @db.Decimal(12, 2)
  currency         String?       @db.Char(3)
  documentId       String?       @map("document_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  trip     Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  flights  Flight[]
  expenses Expense[]

  @@map("bookings")
}

// Airline travel credit, e.g. a Delta eCredit left over from a cancelled or changed ticket.
model ECredit {
  id                 String        @id @default(uuid()) @db.Uuid
  number             String        @unique
  airline            String?
  // Unknown until a receipt shows it; a cancellation email only gives the number.
  amount             Decimal?      @db.Decimal(12, 2)
  currency           String?       @db.Char(3)
  expiresOn          DateTime?     @map("expires_on") @db.Date
  status             ECreditStatus @default(active)
  sourceTicketNumber String?       @map("source_ticket_number")
  documentId         String?       @map("document_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("ecredits")
}

// One flight segment. Local date and times are what the airline prints;
// UTC times are filled in when the airport time zones are known.
model Flight {
  id           String       @id @default(uuid()) @db.Uuid
  bookingId    String?      @map("booking_id") @db.Uuid
  tripId       String?      @map("trip_id") @db.Uuid
  carrier      String       @db.VarChar(3)
  flightNumber String       @map("flight_number") @db.VarChar(8)
  depAirport   String       @map("dep_airport") @db.Char(3)
  arrAirport   String       @map("arr_airport") @db.Char(3)
  depDate      DateTime     @map("dep_date") @db.Date
  depTimeLocal String?      @map("dep_time_local") @db.VarChar(5)
  arrTimeLocal String?      @map("arr_time_local") @db.VarChar(5)
  depTimeUtc   DateTime?    @map("dep_time_utc")
  arrTimeUtc   DateTime?    @map("arr_time_utc")
  seat         String?
  cabin        String?
  fareClass    String?      @map("fare_class") @db.VarChar(2)
  status       FlightStatus @default(scheduled)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  booking Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  trip    Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  changes FlightChange[]

  @@unique([carrier, flightNumber, depDate])
  @@index([tripId])
  @@map("flights")
}

// History of a flight's fields, written when a schedule-change email updates it.
model FlightChange {
  id         String   @id @default(uuid()) @db.Uuid
  flightId   String   @map("flight_id") @db.Uuid
  documentId String?  @map("document_id") @db.Uuid
  field      String
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  flight   Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([flightId])
  @@map("flight_changes")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String?  @map("trip_id") @db.Uuid
  bookingId  String?  @map("booking_id") @db.Uuid
  category   String
  merchant   String?
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @db.Char(3)
  amountHome Decimal? @map("amount_home") @db.Decimal(12, 2)
  spentOn    DateTime @map("spent_on") @db.Date
  documentId String?  @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  trip     Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([bookingId, category])
  @@index([tripId])
  @@map("expenses")
}

model Attachment {
  id            String         @id @default(uuid()) @db.Uuid
  documentId    String         @map("document_id") @db.Uuid
  kind          AttachmentKind @default(other)
  storagePath   String         @map("storage_path")
  thumbnailPath String?        @map("thumbnail_path")
  createdAt     DateTime       @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Airport {
  iata    String  @id @db.Char(3)
  name    String
  city    String?
  state   String?
  country String? @db.Char(2)
  tz      String?

  @@map("airports")
}
